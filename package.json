{
  "name": "@peniti/filament-calendar",
  "private": "true",
  "description": "FullCalendar.js integration for Filament panels",
  "type": "module",
  "scripts": {
    "build:scripts": "node esbuild.js",
    "build:styles": "npx @tailwindcss/cli -c tailwind.config.ts -i resources/css/filament-calendar.css -o dist/filament-calendar.css",
    "build": "npm-run-all -n -s build:*",
    "lint:styles": "stylelint \"resources/**/*.css\"",
    "lint:scripts": "eslint",
    "lint": "npm-run-all -n -s lint:*",
    "start": "npm-run-all -n -p 'build:* -- --watch'"
  },
  "keywords": [
    "filament",
    "calendar",
    "fullcalendar"
  ],
  "author": {
    "name": "Simone Peniti",
    "email": "simone@peniti.it"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/google-calendar": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/luxon3": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@shufo/prettier-plugin-blade": "^1.16.2",
    "@tailwindcss/cli": "^4.2.4",
    "@types/alpinejs": "^3.13.11",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
